{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hualang.local/deck-spec.schema.json",
  "title": "华朗学校整稿页面规格 V12",
  "type": "object",
  "required": [
    "title",
    "scenario",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "description": "internal_report / lesson_plan / classroom / practice / parent_growth / parent_meeting / admissions / public_address，或已登记中文别名"
    },
    "audience": {
      "type": "string"
    },
    "usage": {
      "enum": [
        "read",
        "near",
        "far"
      ]
    },
    "presenter": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "content_only": {
      "type": "boolean",
      "default": false
    },
    "strict_quality": {
      "type": "boolean",
      "default": true,
      "description": "兼容字段，默认 true；当前内容与节奏只作人工复核提示。无效数据、字段丢失和计算错误始终阻断。"
    },
    "closing_text": {
      "type": "string"
    },
    "calculations": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/calculation"
      }
    },
    "source_notes": {
      "type": "string",
      "description": "仅构建报告中的原始资料与审查说明，不写入幻灯片或备注。"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "calculation": {
      "type": "object",
      "required": [
        "comparison_id",
        "subject",
        "baseline",
        "perspective",
        "period",
        "unit",
        "formula",
        "inputs",
        "expected",
        "tolerance"
      ],
      "properties": {
        "comparison_id": {
          "type": "string",
          "minLength": 1
        },
        "subject": {
          "type": "string",
          "minLength": 1
        },
        "baseline": {
          "type": "string",
          "minLength": 1
        },
        "perspective": {
          "type": "string",
          "minLength": 1
        },
        "period": {
          "type": "string",
          "minLength": 1
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "formula": {
          "type": "string",
          "minLength": 1
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "type": "number"
          }
        },
        "expected": {
          "type": "number"
        },
        "tolerance": {
          "type": "number",
          "minimum": 0
        }
      },
      "additionalProperties": true
    },
    "axis": {
      "type": "object",
      "required": [
        "label",
        "min",
        "max"
      ],
      "properties": {
        "label": {
          "type": "string",
          "minLength": 1
        },
        "min": {
          "type": "number"
        },
        "max": {
          "type": "number"
        },
        "unit": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "item": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "color": {
          "type": "string"
        },
        "evidence": {
          "type": "string"
        },
        "implication": {
          "type": "string"
        },
        "action": {
          "type": "string"
        },
        "status": {
          "type": "string"
        },
        "current": {
          "type": [
            "string",
            "number"
          ]
        },
        "target": {
          "type": [
            "string",
            "number"
          ]
        },
        "delta": {
          "type": [
            "string",
            "number"
          ]
        },
        "note": {
          "type": "string"
        },
        "decision": {
          "type": "string"
        },
        "recommendation": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "owner": {
          "type": "string"
        },
        "date": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "value": {
          "type": "number"
        },
        "display": {
          "type": [
            "string",
            "number"
          ]
        },
        "kind": {
          "enum": [
            "start",
            "delta",
            "total"
          ]
        },
        "color": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "column": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text",
                "longtext",
                "number",
                "date",
                "status"
              ]
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "style": {
          "enum": [
            "editorial",
            "comparison",
            "matrix",
            "schedule",
            "rubric",
            "checklist"
          ]
        },
        "caption": {
          "type": "string"
        },
        "source": {
          "type": "string",
          "description": "内部汇报只写入构建报告；教学、学术及对外材料可渲染必要出处。"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "focus_columns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "focus_rows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_row": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "auto",
            "statement",
            "section",
            "comparison",
            "table",
            "timeline",
            "process",
            "evidence",
            "lesson",
            "activity",
            "practice",
            "metrics",
            "bars",
            "image",
            "positioning",
            "waterfall",
            "trend",
            "diagnostic",
            "targets",
            "conversion",
            "swimlane",
            "decision"
          ]
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "context": {
          "type": "string",
          "description": "观众需要的期间、单位、范围和模拟/拟议状态，保持可见。"
        },
        "source": {
          "type": "string",
          "description": "内部汇报只写入构建报告；教学、学术及对外材料可渲染必要出处。"
        },
        "body": {
          "type": "string"
        },
        "basis": {
          "type": [
            "string",
            "object"
          ],
          "properties": {
            "title": {
              "type": "string"
            },
            "body": {
              "type": "string"
            }
          },
          "additionalProperties": true,
          "description": "观众需要的实质依据、解释与取舍；不放内部文件路径、页签索引或计算过程。"
        },
        "appendix": {
          "type": "boolean",
          "default": false,
          "description": "资料附页单列统计，仍须检查内容完整、可读与正确性。"
        },
        "x_axis": {
          "$ref": "#/$defs/axis"
        },
        "y_axis": {
          "$ref": "#/$defs/axis"
        },
        "x_reference": {
          "type": "number"
        },
        "y_reference": {
          "type": "number"
        },
        "points": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "label",
              "x",
              "y"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              },
              "color": {
                "type": "string"
              },
              "note": {
                "type": "string"
              },
              "display_x": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "display_y": {
                "type": [
                  "string",
                  "number"
                ]
              }
            },
            "additionalProperties": true
          }
        },
        "categories": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "stages": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label",
              "definition",
              "owner"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "definition": {
                "type": "string"
              },
              "target": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "owner": {
                "type": "string"
              }
            },
            "additionalProperties": true
          }
        },
        "periods": {
          "type": "array",
          "minItems": 1,
          "maxItems": 12,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "lanes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "type": "object",
            "required": [
              "label",
              "owner",
              "tasks"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "owner": {
                "type": "string"
              },
              "tasks": {
                "type": "array",
                "minItems": 1,
                "maxItems": 6,
                "items": {
                  "type": "object",
                  "required": [
                    "start",
                    "end",
                    "label",
                    "deliverable"
                  ],
                  "properties": {
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "label": {
                      "type": "string"
                    },
                    "deliverable": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string"
                    }
                  },
                  "additionalProperties": true
                }
              }
            },
            "additionalProperties": true
          }
        },
        "tier": {
          "enum": [
            "read",
            "near",
            "far"
          ]
        },
        "usage": {
          "enum": [
            "read",
            "near",
            "far"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 5
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "left": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 3
            }
          }
        },
        "right": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 3
            }
          }
        },
        "split": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 0.75
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "maxItems": 4,
          "minItems": 1
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "values": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": "number"
                }
              },
              "displays": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "type": [
                    "string",
                    "number"
                  ]
                }
              },
              "display": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          },
          "maxItems": 7,
          "minItems": 1
        },
        "max_value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "task": {
          "type": "string"
        },
        "work": {
          "type": "string"
        },
        "work_size": {
          "type": "number"
        },
        "work_bold": {
          "type": "boolean"
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          },
          "maxItems": 4
        },
        "independent_task": {
          "type": "string"
        },
        "answer": {
          "type": [
            "string",
            "array"
          ]
        },
        "answers": {
          "type": [
            "string",
            "array"
          ]
        },
        "answer_lead": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "image": {
          "type": "string"
        },
        "image_title": {
          "type": "string"
        },
        "image_brief": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "orientation": {
          "enum": [
            "left",
            "right"
          ]
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bleed": {
          "type": "boolean"
        },
        "text_side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "action": {
          "type": "string"
        },
        "reveal": {
          "type": "boolean"
        },
        "feedback_items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/item"
          }
        },
        "role": {
          "type": "string",
          "description": "按场景记录本页职责，供内容审阅，不渲染。"
        },
        "reader_question": {
          "type": "string",
          "description": "本页回答的读者问题，供内容审阅，不渲染。"
        },
        "new_information": {
          "type": "string",
          "description": "本页新增的事实、推理或动作，供内容审阅，不渲染。"
        },
        "task_label": {
          "type": "string",
          "description": "lesson底部任务标签；教师教案默认实施提示，其余默认独立作答。"
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "enum": [
                  "statement",
                  "section",
                  "image"
                ]
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 3
              }
            }
          }
        }
      ]
    }
  }
}
