{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hualang.local/deck-spec.schema.json",
  "title": "华朗学校整稿页面规格 V11",
  "type": "object",
  "required": [
    "title",
    "scenario",
    "slides"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "default": "1.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "topic": {
      "type": "string"
    },
    "scenario": {
      "type": "string",
      "description": "internal_report / lesson_plan / classroom / practice / parent_growth / parent_meeting / admissions / public_address，或已登记中文别名"
    },
    "audience": {
      "type": "string"
    },
    "usage": {
      "enum": [
        "read",
        "near",
        "far"
      ]
    },
    "presenter": {
      "type": "string"
    },
    "date": {
      "type": "string"
    },
    "content_only": {
      "type": "boolean",
      "default": false
    },
    "closing_text": {
      "type": "string"
    },
    "source_notes": {
      "type": "string"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/slide"
      }
    }
  },
  "$defs": {
    "item": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "color": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "step": {
      "type": "object",
      "properties": {
        "date": {
          "type": "string"
        },
        "time": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "task": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "detail": {
          "type": "string"
        },
        "expected": {
          "type": "string"
        },
        "feedback": {
          "type": "string"
        }
      },
      "additionalProperties": true
    },
    "column": {
      "oneOf": [
        {
          "type": "string"
        },
        {
          "type": "object",
          "required": [
            "label"
          ],
          "properties": {
            "key": {
              "type": "string"
            },
            "label": {
              "type": "string"
            },
            "type": {
              "enum": [
                "text",
                "longtext",
                "number",
                "date",
                "status"
              ]
            },
            "weight": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "min_width": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "additionalProperties": true
        }
      ]
    },
    "table": {
      "type": "object",
      "required": [
        "columns",
        "rows"
      ],
      "properties": {
        "style": {
          "enum": [
            "editorial",
            "comparison",
            "matrix",
            "schedule",
            "rubric",
            "checklist"
          ]
        },
        "caption": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "columns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "rows": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": [
              "array",
              "object"
            ]
          }
        },
        "focus_columns": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "focus_rows": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "total_row": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": true
    },
    "slide": {
      "type": "object",
      "properties": {
        "layout": {
          "enum": [
            "auto",
            "statement",
            "section",
            "comparison",
            "table",
            "timeline",
            "process",
            "evidence",
            "lesson",
            "activity",
            "practice",
            "metrics",
            "bars",
            "image"
          ]
        },
        "title": {
          "type": "string"
        },
        "lead": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        },
        "context": {
          "type": "string"
        },
        "source": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "tier": {
          "enum": [
            "read",
            "near",
            "far"
          ]
        },
        "usage": {
          "enum": [
            "read",
            "near",
            "far"
          ]
        },
        "items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "maxItems": 4
        },
        "steps": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "left": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 3
            }
          }
        },
        "right": {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "maxItems": 3
            }
          }
        },
        "split": {
          "type": "number",
          "minimum": 0.25,
          "maximum": 0.75
        },
        "table": {
          "$ref": "#/$defs/table"
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "value",
              "label"
            ],
            "properties": {
              "value": {
                "type": [
                  "string",
                  "number"
                ]
              },
              "label": {
                "type": "string"
              },
              "note": {
                "type": "string"
              }
            }
          },
          "maxItems": 4,
          "minItems": 1
        },
        "series": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "label",
              "value"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "number",
                "minimum": 0
              },
              "display": {
                "type": "string"
              },
              "color": {
                "type": "string"
              }
            }
          },
          "maxItems": 7,
          "minItems": 1
        },
        "max_value": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "task": {
          "type": "string"
        },
        "work": {
          "type": "string"
        },
        "work_size": {
          "type": "number"
        },
        "work_bold": {
          "type": "boolean"
        },
        "prompts": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          },
          "maxItems": 4
        },
        "independent_task": {
          "type": "string"
        },
        "answer": {
          "type": [
            "string",
            "array"
          ]
        },
        "answers": {
          "type": [
            "string",
            "array"
          ]
        },
        "answer_lead": {
          "type": "string"
        },
        "questions": {
          "type": "array",
          "items": {
            "type": [
              "string",
              "object"
            ]
          }
        },
        "image": {
          "type": "string"
        },
        "image_title": {
          "type": "string"
        },
        "image_brief": {
          "type": "string"
        },
        "caption": {
          "type": "string"
        },
        "orientation": {
          "enum": [
            "left",
            "right"
          ]
        },
        "fit": {
          "enum": [
            "cover",
            "contain"
          ]
        },
        "focus": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "bleed": {
          "type": "boolean"
        },
        "text_side": {
          "enum": [
            "left",
            "right"
          ]
        },
        "action": {
          "type": "string"
        },
        "reveal": {
          "type": "boolean"
        },
        "feedback_items": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/item"
          }
        }
      },
      "additionalProperties": true,
      "allOf": [
        {
          "if": {
            "properties": {
              "layout": {
                "enum": [
                  "statement",
                  "section",
                  "image"
                ]
              }
            },
            "required": [
              "layout"
            ]
          },
          "then": {
            "properties": {
              "items": {
                "maxItems": 3
              }
            }
          }
        }
      ]
    }
  }
}
