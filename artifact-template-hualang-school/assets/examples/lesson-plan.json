  "schema_version": "1.0",
  "title": "文本证据阅读教案",
  "scenario": "lesson_plan",
  "audience": "初中语文教研组",
  "presenter": "语文教研组",
  "date": "2026年11月8日",
  "slides": [
    {
      "layout": "table",
      "title": "证据链评价量规",
      "context": "演示版 · 原创教学方案；适用于已具备基础概括能力的七年级学生。",
      "table": {
        "style": "rubric",
        "columns": [
          {
            "label": "评价维度",
            "type": "text"
          },
          {
            "label": "达成",
            "type": "longtext",
            "weight": 2.0
          },
          {
            "label": "待支持",
            "type": "longtext",
            "weight": 2.0
          },
          {
            "label": "反馈动作",
            "type": "longtext",
            "weight": 1.6
          }
        ],
        "rows": [
          [
            "证据选择",
            "两处词句均支持判断",
            "只有一处或词句关联较弱",
            "回到人物动作与语言"
          ],
          [
            "联系解释",
            "说明词句如何支持判断",
            "复述词句，缺少推理",
            "补充因果或转折说明"
          ],
          [
            "独立迁移",
            "新文本中完整完成",
            "需要句式或教师提示",
            "减少提示后再次作答"
          ]
        ],
        "source": "来源：演示版原创量规；实际使用按学段目标调整"
      },
      "lead": "学生能从完整文本中选择词句，解释证据与人物判断的联系。"
    },
    {
      "layout": "activity",
      "title": "文本证据活动安排",
      "lead": "每个活动都保留预期回应与错误后的处理。",
      "steps": [
        {
          "time": "5分钟",
          "task": "默读完整选段，写出一个人物判断",
          "expected": "学生给出初步判断，能回到文本找依据",
          "feedback": "只有概括时，要求标出对应段落"
        },
        {
          "time": "8分钟",
          "task": "圈出两处动作或语言描写",
          "expected": "学生选择能支持判断的具体词句",
          "feedback": "只找形容词时，追问哪个动作能够验证"
        },
        {
          "time": "10分钟",
          "task": "两人互读证据链并补充理由",
          "expected": "学生能说出词句与判断之间的联系",
          "feedback": "理由脱节时，提供“词句说明……因此……”句式"
        },
        {
          "time": "12分钟",
          "task": "在新选段中独立完成证据链",
          "expected": "学生迁移方法并写出完整解释",
          "feedback": "按证据选择、联系解释分别标记待支持点"
        }
      ]
    }
  ]
}
